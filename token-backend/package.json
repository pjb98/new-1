{
  "name": "tinydead-token-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trusted reward backend for Tiny Dead — owns the earnings ledger and signs $TOKEN payouts. The game client never mints value.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
